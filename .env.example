# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file or share your token publicly.

# Your Discord bot token (regenerate it in the Developer Portal if it ever leaks)
DISCORD_TOKEN=

# Role ID allowed to use the bot at all.
ACCESS_ROLE_ID=your-access-role-id

# Role ID that gets exclusive/priority control of playback.
PRIORITY_ROLE_ID=your-priority-role-id

# --- YouTube access (needed on a VPS / datacenter IP) ---
# Residential proxy to route all YouTube requests through.
# Supports: http, https, socks4, socks5
# You can specify a single proxy or a comma-separated list of multiple proxies for rotation/fallback.
# Examples:
#   YT_PROXY=socks5://username:password@proxy-host:port
#   YT_PROXY=http://username:password@proxy-host1:port,http://username:password@proxy-host2:port
YT_PROXY=

# Optional: cookies from a logged-in YouTube account (Netscape cookies.txt format).
# Helps avoid bot checks even with a good proxy.
# YT_COOKIES_FILE=/path/to/cookies.txt

# --- Desktop App REST API Bridge ---
# Port the REST API listens on (default: 3456). Only binds to 127.0.0.1.
API_PORT=3456

# Secret key the desktop app must send in every request.
# Set this to any long random string and copy it into the desktop app Settings.
API_SECRET=change-me-to-a-long-random-secret

