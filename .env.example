# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file or share your token publicly.

# Your Discord bot token (regenerate it in the Developer Portal if it ever leaks)
DISCORD_TOKEN=your-bot-token-here

# Role ID allowed to use the bot at all.
ACCESS_ROLE_ID=your-access-role-id

# Role ID that gets exclusive/priority control of playback.
# While a member with this role is playing, others can't control playback
# until that member leaves the voice channel or stops the music.
PRIORITY_ROLE_ID=your-priority-role-id

# --- YouTube auth (needed on a VPS / datacenter IP) ---
# YouTube blocks datacenter IPs with "Sign in to confirm you're not a bot".
# Export cookies.txt from a logged-in YouTube account (Netscape format) and
# point to it here. This is the reliable fix on a server.
# YT_COOKIES_FILE=/var/scify/cookies.txt
#
# Alternatively, pull cookies from a local browser profile (rarely available
# on a VPS): chrome, firefox, edge, etc.
# YT_COOKIES_FROM_BROWSER=chrome
